// HAL module implemenation stored in
// hw/<OVERLAY_HARDWARE_MODULE_ID>.<ro.product.board>.so
cc_prebuilt_library_shared {
    name: "libX11",
    arch: {
        arm: {
            enabled: false,
        },
        x86 : {
            enabled : false,
        },
        x86_64 : {
            enabled : false,
        },
        arm64: {
            srcs: ["lib/libX11.so"],
        },
    },

    shared_libs: [
        "libxcb",
        "libandroid-support",
        "libdl",
    ],
    proprietary : true,
    vendor: false,
    visibility: ["//hardware/waydroid/hwcomposer"],
}


cc_prebuilt_library_shared {
    name: "libandroid-support",
    arch: {
        arm: {
            enabled: false,
        },
        x86 : {
            enabled : false,
        },
        x86_64 : {
            enabled : false,
        },
        arm64: {
            srcs: ["lib/libandroid-support.so"],
        },
    },
    proprietary : true,
    vendor: false,
    visibility: ["//hardware/waydroid/hwcomposer"],
}

